.sk-page{
  background:#f5f7fb;
}

.img_bg{
  position:fixed;
  z-index:-1;
  width:100%;
  height:100%;
}

.panel{
  margin:1rem 4% 0;
  background:#fff;
  box-shadow:0 0.25rem 0.8rem rgba(0,0,0,0.06);
  border-radius:0.45rem;
  overflow:hidden;
}

.form-panel{
  padding:0.4rem 0 1rem;
}

.device-box{
  margin:0.2rem 10% 0.4rem;
  padding:0.55rem 0.7rem;
  background:#f5fbff;
  color:#339adc;
  border-radius:0.35rem;
  font-size:0.82rem;
  line-height:1.5;
}

.tip-box{
  margin:0 10% 0.5rem;
  color:#999;
  font-size:0.8rem;
  line-height:1.6;
}

.field{
  margin:0.9rem 10%;
  border-bottom:1px solid #77b8e8;
  min-height:1.9rem;
  display:flex;
  align-items:center;
}

.field-time{
  align-items:flex-start;
  flex-wrap:wrap;
  padding:0.45rem 0;
}

.field-icon{
  width:1rem;
  height:1rem;
  flex-shrink:0;
}

.field-time .field-icon{
  margin-top:0.2rem;
}

.field-input{
  flex:1;
  min-width:0;
  padding-left:0.5rem;
}

.section{
  margin-left:0.45rem;
  margin-bottom:0.25rem;
  width:fit-content;
}

.picker-text{
  color:#666;
  white-space:nowrap;
  padding-right:0.5rem;
}

.suffix{
  color:#999;
}

.submit-btn{
  margin:0 12%;
}
