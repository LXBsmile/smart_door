<view class="container sk-page">
  <image class='img_bg' src='/images/fxys_bg2.png' mode='scaleToFill'></image>
  <!-- <courtpicker courtName='{{thisCourtName}}' courts='{{courts}}' index='{{index}}' showPicker='{{false}}' bindchange='selectcourt'></courtpicker> -->

  <form class='panel form-panel' catchsubmit='formSubmit'>
    <view class='device-box' wx:if='{{shareDeviceName}}'>当前分享设备：{{shareDeviceName}}</view>
    <view class='tip-box'>分享链接会自动复制到剪贴板，发送给使用人即可绑定。</view>

    <view class='field'>
      <image class='field-icon' src='/images/fxys_fk.png' mode='aspectFit'></image>
      <input class='field-input' name='name' maxlength='10' placeholder='输入访客姓名' bindinput='inputname' value='{{name}}'></input>
    </view>

    <view class='field'>
      <image class='field-icon' src='/images/fxys_sj.png' mode='aspectFit'></image>
      <input class='field-input' name='tel' maxlength='11' type='number' placeholder='输入手机号码' bindinput='inputtel' value='{{tel}}'></input>
    </view>

    <view class='field field-time'>
      <image class='field-icon' src='/images/fxys_rq.png' mode='aspectFit'></image>
      <view class='section'>
        <picker mode='date' fields='year' value='{{inputYear}}' start='{{startYear}}' end='{{endYear}}' bindchange='bindYearChange' disabled='{{dateDis}}'>
          <view class='picker-text'>{{inputYear}} 年</view>
        </picker>
      </view>
      <view class='section'>
        <picker value='{{monthIndex}}' bindchange='bindMonthChange' range='{{monthArray}}' disabled='{{dateDis}}'>
          <view class='picker-text'>{{monthArray[monthIndex]}} 月</view>
        </picker>
      </view>
      <view class='section'>
        <picker value='{{dayIndex}}' bindchange='bindDayChange' range='{{dayArray}}' disabled='{{dateDis}}'>
          <view class='picker-text'>{{dayArray[dayIndex]}} 日</view>
        </picker>
      </view>
      <view class='section'>
        <picker bindchange='bindTimeChange' value='{{timeIndex}}' range='{{timeArray}}' disabled='{{dateDis}}'>
          <view class='picker-text'>{{timeArray[timeIndex]}} 时</view>
        </picker>
      </view>
    </view>

    <view class='field'>
      <image class='field-icon' src='/images/fxys_cs.png' mode='aspectFit'></image>
      <input class='field-input' name='counts' maxlength='2' type='number' placeholder='输入使用次数' bindinput='inputcounts' value='{{counts}}'></input>
      <text class='suffix'>次</text>
    </view>

    <button type='primary' class='submit-btn' formType='submit' disabled='{{disabled}}'>立即分享</button>
  </form>
</view>
