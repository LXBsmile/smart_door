.page-content {
  margin: 1rem;
  background-color: #fff;
  border-radius: 0.45rem;
  overflow: hidden;
  box-shadow: 0 0.25rem 0.8rem rgba(0,0,0,0.06);
}

.qr-section {
  padding: 1.35rem 0 0;
}
.img_bg{
  position: fixed;
  z-index: -1;
  width:100%;
  height: 100%;
}
.head{
  height:3rem;
  background-color: white;
  display: flex;
  justify-content: center;
  align-items: center;
  border-bottom: solid 1px #ebebeb;
}
.img_court{
  height:2.1rem;
}
.canvas-box{
  display: flex;
  justify-content: center;
  align-items: center;
  width:100%;
  min-height:260px;
  text-align: center;
}
.guide{
  margin-top:0;
  padding:0.8rem 1rem 1rem;
  background:#fff;
  color:#444;
  font-size:30rpx;
  line-height:1.8;
  box-shadow:none;
  border-radius:0;
  overflow:hidden;
}
.guide-item{
  margin-bottom:0.25rem;
}
.btn-create {
  display: block;
  width: 40%;
  text-align: center;
  margin: 1.5rem auto 1.5rem;
}
.nopermit{
  height:12rem;
  background:#fff;
  display:flex;
  justify-content:center;
  align-items:center;
  font-size:1.1rem;
  color:#666;
  box-shadow:0 0.3rem 0.9rem rgba(0,0,0,0.06);
  border-radius:0.45rem;
  overflow:hidden;
}
