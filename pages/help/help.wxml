<view class='contain'>
<view class='white'></view>
<view class='yellow'></view>
  <view class='head'>
    <image class='img_court' src='/images/bzzx_xq.png'></image>
    <view class='court_name'>{{thisCourtName}}</view>
    <picker bindchange='selectcourt' value="{{index}}" range="{{courts}}" range-key='GroupName'>
      <view class='court12' >切换小区</view>
    </picker>
  </view>
  <view class='body'>
  <view class='body1'>
  <view class='view1'>
    <view class='view11'>服务单位</view>
    <view class='view12'>{{unit}}</view>
  </view>
  <view class='view1'>
    <view class='view11'>服务电话</view>
    <view class='view12'>{{tel}}</view>
  </view>
  <view class='view1'>
    <view class='view11'>联系地址</view>
    <view class='view12'>{{address}}</view>
  </view>
  <view class='view1'>
    <view class='view11'>邮箱</view>
    <view class='view12'>{{email}}</view>
  </view>
  <view class='view1'>
    <view class='view11'>网址</view>
    <view class='view12'>{{web}}</view>
  </view>
  </view>
  <view class='view2'>
    <view class='view21'>单位介绍</view>
    <view class='view22'><rich-text nodes='{{introduce}}'></rich-text></view>
  </view>
  </view>
</view>
