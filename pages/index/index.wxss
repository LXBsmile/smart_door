/**index.wxss**/
.banner {
  width: 100%;
  margin: 0;
  padding-top:0;
}
.bannerImage {
  width:100%;
  height:10rem;
  padding-top:0;
}
.desktop {
  margin:5%;
  height: fit-content;
  background-color: white;
  display: flex;
  justify-content:flex-start;
  flex-direction:row;
  flex-wrap: wrap;
  border-radius: 2%;
}
.navigator-menu {
  padding:5%;
  width:23.33%;
  height:fit-content;
  text-align: center;
  display: flex;
  justify-content: center;
  flex-direction: column;
  align-items: center;
}
.list-img {
  width:4rem;
  height:4rem;
}
.mask{
    width: 100%;
    height: 100%;
    position: fixed;
    top: 0;
    left: 0;
    background: #000;
    z-index: 1;
    opacity: 0.7;
}
.view-menu{
  background-color: #e2e2e2
}
.pwd_view{
  font-size: 2rem;
  text-align: center;
}

.cov{
  position: absolute;
  height:100%;
  width:100%;
}