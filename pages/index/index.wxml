<!--index.wxml-->
<wxs module="m1">
    var menu=[{
      id:'keyslist',
      name:'钥匙列表',
      url:'/pages/keyslist/keyslist',
      image:'/images/home_yslb.png'
    },{
      id: 'sharekeys',
      name: '分享钥匙',
      url: '/pages/sharekeys/sharekeys',
      image: '/images/home_fxys.png'
    },{
      id:'showQR',
      name:'扫一扫',
      url:'',
      image:'/images/code3.png',
      online:true
    },{
      id:'paycenter',
      name:'缴费中心',
      url:'/pages/paycenter/paycenter',
      image:'/images/home_jfzx.png',
      online:true
    },{
      id:'anno',
      name:'公告中心',
      url:'/pages/anno/anno',
      image:'/images/home_ggzx.png'
    },{
      id:'help',
      name:'帮助',
      url:'/pages/help/help',
      image:'/images/home_bz.png'
    }];
    module.exports.menu=menu;
</wxs>
<view class="container">
  <view class="banner">
    <image src="/images/banner.png" class="bannerImage"></image>
  </view>
  <view class="desktop">
    <block wx:for-items="{{m1.menu}}" wx:key="item.id">
      <view id="{{item.id}}" bindtap="clickMenu" data-online="{{item.online}}" class="navigator-menu" hover-class="view-menu">
        <image class="list-img" src="{{item.image}}"></image>
        <view class="list-text">{{item.name}}</view>
      </view>
    </block>
  </view>
  <modal hidden="{{hiddenmodal}}" title="设备已离线，请使用此密码开门：" confirm-text="确认" no-cancel='true' bindconfirm="confirm">
    <view class='pwd_view'>{{password}}</view>
  </modal>
</view>
  <view class="tabBar">
      <view class="tabBar-item">
        <view class="viewalltab"><image class="icon" src='/images/home.png'></image></view>
        <view class="tabBartext">首页</view>
    </view>
    <view class="tabBar-item" bindtap='switchtab2'>
        <view class="viewalltab"><image class="icon" src='/images/qxm2.png'></image></view>
        <view class="tabBartext">权限码</view>
    </view>
    <view class="tabBar-item" bindtap='switchtab3'>
        <view class="viewalltab"><image class="icon" src='/images/me.png'></image></view>
        <view class="tabBartext">我的</view>
    </view>
  </view>
