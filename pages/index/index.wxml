<!--index.wxml-->
<view class="container">
  <view class="customNav" style="height: {{navBarHeight}}px; padding-top: {{statusBarHeight}}px;">
    <view class="customNavInner" style="height: {{navContentHeight}}px; padding-right: {{navRightSpace}}px;">
      <picker
        wx:if="{{isRegisted&&courts.length}}"
        class="navCourtPicker"
        bindchange='selectcourt'
        value="{{index}}"
        range="{{courts}}"
        range-key='GroupName'>
        <view class="navCourtButton">
          <text class="navCourtName">{{thisCourtName}}</text>
        </view>
      </picker>
      <view wx:else class="navCourtButton navCourtPlaceholder">
        <text class="navCourtName">小区选择</text>
      </view>
    </view>
  </view>
  <view class="banner">
    <image src="{{bannerImage}}" class="bannerImage"></image>
  </view>
  <view wx:if="{{isRegisted}}" class="index-top">
    <view class="annoBar" bindtap="gotoAnno">
      <image class="annoIcon" src="/images/home_ggzx.png" mode="aspectFit"></image>
      <view class="annoText">{{announcement}}</view>
      <view class="annoMore">更多</view>
    </view>
  </view>
  <view class="desktop {{!isRegisted ? 'desktopGuest' : ''}}">
    <block wx:for="{{menus}}" wx:key="id">
      <view id="{{item.id}}" bindtap="clickMenu" data-online="{{item.online}}" class="navigator-menu" hover-class="view-menu">
        <view wx:if="{{item.iconBg}}" class="menuIconCard" style="background: {{item.iconBg}};">
          <image class="list-img list-img-plain" src="{{item.image}}" mode="aspectFit"></image>
        </view>
        <image wx:else class="list-img" src="{{item.image}}" mode="aspectFit"></image>
        <view class="list-text">{{item.name}}</view>
      </view>
    </block>
  </view>
  <modal hidden="{{hiddenmodal}}" title="设备已离线，请使用此密码开门：" confirm-text="确认" no-cancel='true' bindconfirm="confirm">
    <view class='pwd_view'>{{password}}</view>
  </modal>
</view>
<view class="tabBar">
  <view class="tabBar-item">
    <view class="viewalltab">
      <image class="icon" src='/images/home.png'></image>
    </view>
    <view class="tabBartext">首页</view>
  </view>
  <view class="tabBar-item" bindtap='switchtab2' hidden="{{!isRegisted||!canOfflinePermission}}">
    <view class="viewalltab">
      <image class="icon" src='/images/qxm2.png'></image>
    </view>
    <view class="tabBartext">权限码</view>
  </view>
  <view class="tabBar-item" bindtap='switchtab3'>
    <view class="viewalltab">
      <image class="icon" src='/images/me.png'></image>
    </view>
    <view class="tabBartext">我的</view>
  </view>
</view>
