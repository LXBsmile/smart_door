<view class='container'>
  <view class='head'>
    <image class='img_court' src='/images/bzzx_xq.png'></image>
    <view class='court11'><text class='court111'>{{thisCourtName}}</text><text class='view112'>{{group}}</text></view>
    <picker bindchange='selectcourt' value="{{index}}" range="{{courts}}" range-key='GroupName'>
      <view class='court12'>切换小区</view>
    </picker>
  </view>
  <view class='body'>
    <view class='body1'>
      <view class='b1'>
        <image src='/images/jfzx_xm.png'></image>
        <text class='b11'>用户姓名</text>
      </view>
      <view>{{name}}</view>
    </view>
    <view class='body1'>
      <view class='b1'>
        <image src='/images/jfzx_dh.png'></image>
        <text class='b11'>手机号码</text>
      </view>
      <text>{{tel}}</text>
    </view>
    <view class='body1'>
      <view class='b1'>
         <image src='/images/jfzx_ye.png'></image>      
          <text class='b11'>余额</text>
      </view>     
      <text>{{money}}</text>
    </view>
    <view class='body1'>
      <view class='b1'>
         <image src='/images/jfzx_sj.png'></image>      
          <text class='b11'>到期时间</text>
      </view>     
      <text>{{validity}}</text>
    </view>
  </view>
  <view class='foot'>
    <view class='c31' bindtap='gotocharge'>余额充值</view>
    <view class='c32' bindtap='gotodelay'>延期缴费</view>
  </view>
</view>