<view class='container'>
  <!-- <courtpicker courtName='{{thisCourtName}}' subText='{{group}}' courts='{{courts}}' index='{{index}}' showPicker='{{false}}' bindchange='selectcourt'></courtpicker> -->
  <view class='body'>
    <view class='body1'>
      <view class='b1'>
        <image src='/images/jfzx_xm.png'></image>
        <text class='b11'>用户姓名</text>
      </view>
      <view>{{name}}</view>
    </view>
    <view class='body1'>
      <view class='b1'>
        <image src='/images/jfzx_dh.png'></image>
        <text class='b11'>手机号码</text>
      </view>
      <text>{{tel}}</text>
    </view>
    <view class='body1' hidden='{{!showBalance}}'>
      <view class='b1'>
         <image src='/images/jfzx_ye.png'></image>      
          <text class='b11'>余额</text>
      </view>     
      <text>{{money}}</text>
    </view>
    <view class='body1'>
      <view class='b1'>
         <image src='/images/jfzx_sj.png'></image>      
          <text class='b11'>到期时间</text>
      </view>     
      <text>{{validity}}</text>
    </view>
  </view>
  <view class='foot' hidden='{{!showRecharge&&!showDelay}}'>
    <view class='c31 {{showRecharge&&showDelay?"":"singleAction"}}' bindtap='gotocharge' hidden='{{!showRecharge}}'>余额充值</view>
    <view class='c32 {{showRecharge&&showDelay?"":"singleAction"}}' bindtap='gotodelay' hidden='{{!showDelay}}'>延期缴费</view>
  </view>
</view>
