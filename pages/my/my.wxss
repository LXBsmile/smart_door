/* pages/my/my.wxss */
.container {
  position: relative;
  min-height: 100%;
  background: linear-gradient(180deg, #f0f5fb 0%, #eef2f7 220rpx, #eef2f6 100%);
  padding-bottom: 132rpx;
  overflow: hidden;
  box-sizing: border-box;
}

.customNav {
  position: relative;
  z-index: 3;
  background: #339adc;
}

.customNavInner {
  position: relative;
  display: flex;
  align-items: center;
  padding-left: 1rem;
  box-sizing: border-box;
}

.navCourtPicker {
  display: block;
  max-width: calc(100vw - 7.5rem);
}

.navCourtButton {
  position: relative;
  z-index: 2;
  max-width: 50vw;
  min-height: 1.95rem;
  padding: 0 0.9rem 0 0.78rem;
  border-radius: 999rem;
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  background: rgba(255, 255, 255, 0.18);
  border: 1px solid rgba(255, 255, 255, 0.24);
  box-sizing: border-box;
}

.navCourtName {
  min-width: 0;
  color: rgba(255, 255, 255, 0.96);
  font-size: 0.88rem;
  line-height: 1.4;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  flex: 1;
}

.navCourtPlaceholder {
  opacity: 0;
}


.pageGlow {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.pageGlowTop {
  top: -120rpx;
  right: -110rpx;
  width: 380rpx;
  height: 380rpx;
  background: rgba(70, 170, 239, 0.2);
}

.pageGlowBottom {
  top: 260rpx;
  left: -120rpx;
  width: 280rpx;
  height: 280rpx;
  background: rgba(255, 255, 255, 0.72);
}

.topWrap,
.guestCard,
.contentArea {
  position: relative;
  z-index: 1;
}

.topWrap {
  padding: 28rpx 24rpx 0;
}

.topCard {
  border-radius: 32rpx;
  padding: 28rpx;
  background: linear-gradient(180deg, #48a9ee 0%, #2f8fca 100%);
  box-shadow: 0 18rpx 36rpx rgba(44, 131, 192, 0.22);
  box-sizing: border-box;
}

.topBadgeRow {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 22rpx;
}

.topWelcome,
.statusTag {
  height: 46rpx;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.topWelcome {
  color: rgba(255, 255, 255, 0.92);
  font-size: 36rpx;
}

.statusTag {
  padding: 0 18rpx;
  background: rgba(255, 255, 255, 0.22);
  color: #fff;
  font-size: 22rpx;
}

.statusTag.ghost {
  background: rgba(255, 255, 255, 0.14);
}

.userRow {
  display: flex;
  align-items: center;
}

.avatarBox {
  position: relative;
  width: 136rpx;
  height: 136rpx;
  margin-right: 46rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatarHalo {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.16);
  border: 1rpx solid rgba(255, 255, 255, 0.28);
}

.image1 {
  position: relative;
  z-index: 1;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.96);
}

.topInfo {
  flex: 1;
  min-width: 0;
}

.phoneText {
  display: block;
  color: rgba(255, 255, 255, 0.98);
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.35;
}

.courtMeta {
  display: block;
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.92);
  font-size: 24rpx;
  line-height: 1.45;
}

.subInfo {
  display: block;
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.76);
  font-size: 22rpx;
  line-height: 1.6;
}

.phoneSubText {
  display: block;
  color: rgba(255, 255, 255, 0.96);
  font-size: 28rpx;
  line-height: 1.5;
  font-weight: 500;
  /* flex: 1; */
  min-width: 0;
}

.contactRow {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 12rpx;
}

.actionRow {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.actionBtn {
  min-width: 140rpx;
  height: 64rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  font-size: 24rpx;
}

.actionBtn.primary {
  background: #fff;
  color: #339adc;
  box-shadow: 0 8rpx 20rpx rgba(255, 255, 255, 0.18);
}

.actionBtn.light {
  background: rgba(255, 255, 255, 0.18);
  color: #fff;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

.actionBtn.ghost {
  background: rgba(255, 255, 255, 0.1);
  color: #fff;
  border: 1rpx solid rgba(255, 255, 255, 0.24);
}

.actionBtn.compact {
  min-width: 124rpx;
  height: 56rpx;
  padding: 0 18rpx;
  font-size: 22rpx;
  flex-shrink: 0;
}

.summaryRow {
  display: flex;
  gap: 14rpx;
  margin-top: 26rpx;
}

.summaryItem {
  flex: 1;
  min-width: 0;
  padding: 22rpx 20rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.16);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  box-sizing: border-box;
}

.summaryItem.noBorder {
  border: 1rpx solid rgba(255, 255, 255, 0.12);
}

.summaryLabel {
  color: rgba(255, 255, 255, 0.8);
  font-size: 22rpx;
  line-height: 1.4;
}

.summaryHead {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.summaryAction {
  min-width: 92rpx;
  height: 42rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  color: #fff;
  font-size: 22rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  flex-shrink: 0;
}

.summaryValue {
  margin-top: 10rpx;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.4;
  word-break: break-all;
}

.summaryValueMuted {
  color: rgba(255, 255, 255, 0.72);
}

.guestCard {
  margin: 24rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 12rpx 30rpx rgba(16, 41, 68, 0.06);
}

.guestTitle {
  color: #223247;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.5;
}

.guestDesc {
  margin-top: 10rpx;
  color: #8d9aa8;
  font-size: 24rpx;
  line-height: 1.7;
}

.contentArea {
  padding: 24rpx 24rpx 0;
}

.sectionCard {
  margin-bottom: 20rpx;
  background: #fff;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 12rpx 30rpx rgba(16, 41, 68, 0.06);
}

.sectionHead {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 24rpx 28rpx 14rpx;
  box-sizing: border-box;
}

.sectionHeadMenu {
  padding-bottom: 8rpx;
}

.sectionTitle {
  color: #223247;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.4;
}

.sectionHint {
  margin-left: 18rpx;
  color: #97a4b3;
  font-size: 22rpx;
  line-height: 1.5;
  text-align: right;
}

.menuWrap {
  margin-top: 0;
  background: #fff;
  border-top: none;
}

.menuWrap.noTopBorder {
  margin-top: 0;
  border-top: none;
}

.view41 {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: 0 76rpx 0 28rpx;
  border-bottom: 1rpx solid #eef2f6;
  box-sizing: border-box;
}

.view41:last-child {
  border-bottom: none;
}

.menuDot {
  width: 18rpx;
  height: 18rpx;
  margin-right: 20rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, #54baef 0%, #339adc 100%);
  box-shadow: 0 0 0 10rpx rgba(71, 168, 236, 0.14);
  flex-shrink: 0;
}

.menuTextWrap {
  flex: 1;
  min-width: 0;
  padding: 18rpx 0;
}

.navi411 {
  color: #243446;
  font-size: 30rpx;
  line-height: 1.45;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.arrowIcon {
  position: absolute;
  top: 50%;
  right: 30rpx;
  width: 16rpx;
  height: 16rpx;
  border-top: 4rpx solid #adb8c4;
  border-right: 4rpx solid #adb8c4;
  box-sizing: border-box;
  transform: translateY(-50%) rotate(45deg);
}

.canvas-box {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 100%;
  height: 100%;
}
