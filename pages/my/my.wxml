<!--pages/my/my.wxml-->
<view class='container my-page'>
  <view class="customNav" style="height: {{navBarHeight}}px; padding-top: {{statusBarHeight}}px;">
    <view class="customNavInner" style="height: {{navContentHeight}}px; padding-right: {{navRightSpace}}px;">
      <picker
        wx:if="{{showCourtPicker&&allcourts.length}}"
        class="navCourtPicker"
        bindchange='morecourts'
        value="{{pickerIndex}}"
        range="{{allcourts}}"
        range-key='GroupName'>
        <view class="navCourtButton">
          <text class="navCourtName">{{thisCourtName}}</text>
        </view>
      </picker>
      <view wx:else class="navCourtButton navCourtPlaceholder">
        <text class="navCourtName">小区选择</text>
      </view>
    </view>
  </view>

  <view class='pageGlow pageGlowTop'></view>
  <view class='pageGlow pageGlowBottom'></view>

  <view class='topWrap'>
    <view class='topCard'>
      <view class='topBadgeRow'>
        <text class='topWelcome'>欢迎使用智慧云门禁</text>
        <view class='statusTag ghost' hidden='{{!userTagText}}'>{{userTagText}}</view>
      </view>
      <view class='userRow'>
        <view class='avatarBox'>
          <view class='avatarHalo'></view>
          <image class='image1' src='/images/header.png'></image>
        </view>
        <view class='topInfo'>
          <text class='phoneText' wx:if='{{isRegisted}}'>{{maskedName}}</text>
          <text class='phoneText' wx:else>登录后查看账号信息</text>
          <view class='contactRow' wx:if='{{isRegisted}}'>
            <text class='phoneSubText' wx:if='{{maskedTel}}'>{{maskedTel}}</text>
            <view class='actionBtn ghost compact' bindtap='logout'>退出登录</view>
          </view>

          <view class='actionRow' hidden='{{isRegisted}}'>
            <view class='actionBtn primary' bindtap='modifytel'>登录/注册</view>
          </view>
        </view>
      </view>

      <view class='summaryRow' hidden='{{!isRegisted||(!showValidity&&!showDelay&&!showBalance&&!showRecharge)}}'>
        <view class='summaryItem' wx:if='{{showValidity||showDelay}}'>
          <view class='summaryHead'>
            <view class='summaryLabel'>权限期限</view>
            <view class='summaryAction' bindtap='gotodelay' wx:if='{{showDelay}}'>延期</view>
          </view>
          <view class='summaryValue' wx:if='{{showValidity}}'>{{validity}}</view>
          <view class='summaryValue summaryValueMuted' wx:else>--</view>
        </view>
        <view class='summaryItem noBorder' wx:if='{{showBalance && showRecharge}}'>
          <view class='summaryHead'>
            <view class='summaryLabel'>账户余额</view>
            <view class='summaryAction' bindtap='gotocharge'>充值</view>
          </view>
          <view class='summaryValue'>{{money}}元</view>
        </view>
      </view>
    </view>
  </view>

  <view class='guestCard' hidden='{{isRegisted}}'>
    <view class='guestTitle'>登录后可管理个人门禁信息</view>
    <view class='guestDesc'>完成授权后，这里会展示权限期限和常用功能入口。</view>
  </view>

  <view class='contentArea' hidden='{{!isRegisted}}'>
    <view class='sectionCard menuSection'>
      <view class='sectionHead sectionHeadMenu'>
        <text class='sectionTitle'>常用服务</text>
        <text class='sectionHint'>我的记录与联系方式</text>
      </view>

      <view class='menuWrap noTopBorder'>
        <view class='view41' bindtap='gotoMembers' hidden='{{!showMembers}}'>
          <view class='menuDot'></view>
          <view class='menuTextWrap'>
            <view class='navi411'>成员管理</view>
          </view>
          <view class='arrowIcon'></view>
        </view>
        <view class='view41' bindtap='gotoPassRecord'>
          <view class='menuDot'></view>
          <view class='menuTextWrap'>
            <view class='navi411'>通行记录</view>
          </view>
          <view class='arrowIcon'></view>
        </view>
        <view class='view41' bindtap='gotoPaymentRecord' hidden='{{!showRecharge}}'>
          <view class='menuDot'></view>
          <view class='menuTextWrap'>
            <view class='navi411'>缴费记录</view>
          </view>
          <view class='arrowIcon'></view>
        </view>
        <view class='view41' bindtap='gotoHelp2' hidden='{{!hasCourtList}}'>
          <view class='menuDot'></view>
          <view class='menuTextWrap'>
            <view class='navi411'>联系我们</view>
          </view>
          <view class='arrowIcon'></view>
        </view>
      </view>
    </view>
  </view>
</view>

<view class="tabBar">
  <view class="tabBar-item" bindtap='switchtab1'>
    <view class="viewalltab">
      <image class="icon" src='/images/home_notselected.png'></image>
    </view>
    <view class="tabBartext">首页</view>
  </view>
  <view class="tabBar-item" bindtap='switchtab2' hidden="{{!isRegisted||!canOfflinePermission}}">
    <view class="viewalltab">
      <image class="icon" src='/images/qxm2.png'></image>
    </view>
    <view class="tabBartext">权限码</view>
  </view>
  <view class="tabBar-item">
    <view class="viewalltab">
      <image class="icon" src='/images/me_selected.png'></image>
    </view>
    <view class="tabBartext">我的</view>
  </view>
</view>
