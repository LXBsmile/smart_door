<!--pages/my/my.wxml-->
<wxs module="tools">
  var cryptoTelNo = function (tel) {
    if (!tel) return tel;
    var reg = getRegExp('(\d{3})\d{4}(\d{4})', 'g');
    return tel.replace(reg, '$1****$2');
  }
  module.exports = {
    cryptoTelNo: cryptoTelNo
  }
</wxs>

<view class='container'>
  <view class='view1'>
    <view class='view11'>
      <!-- <image hidden="{{!thisuser.f_headpic}}" class='image1' src='{{thisuser.f_headpic}}'></image> -->
      <image class='image1' src='/images/header.png'></image>

    </view>
    <view class='view12'>
      <!-- <text class='text11'>{{thisuser.f_nickname}}\n</text> -->
      <text class='text11'>欢迎使用智慧云门禁</text>
      <view>
        <text class='text12'>{{tools.cryptoTelNo(tel)}}</text>
        <!-- <view class='view121' bindtap='modifytel' hidden="{{!isRegisted}}">修改手机号码</view> -->
        <view class='view121' bindtap='modifytel' hidden="{{isRegisted}}">登录/注册</view>
        <view class='view121' bindtap='logout' hidden="{{!isRegisted}}">退出登录</view>
      </view>
    </view>
  </view>
  <modal hidden="{{hiddenmodal}}" title="添加家庭成员" confirm-text="确认" cancel-text="取消" bindcancel="cancel" bindconfirm="confirm">
    <input type='text' maxlength='11' type='number' placeholder="请输入手机号" bindinput='setMemberID' value='{{inputedID}}' />
  </modal>
  <modal hidden='{{hiddenmodal2}}' title='该用户未注册，请通过扫码添加' confirm-text='完成' no-cancel='true' bindconfirm='complete2'>
    <view class="canvas-box">
      <canvas style="width:200px;height:200px;" canvas-id="mycanvas" />
    </view>
  </modal>
  <view class='yellow' hidden="{{!isRegisted}}"></view>
  <view class='head' hidden="{{!isRegisted}}">
    <image class='img_court' src='/images/bzzx_xq.png'></image>
    <view class='court_name'>{{thiscourt.GroupName}}</view>
    <picker bindchange='morecourts' value="{{index}}" range="{{allcourts}}" range-key='GroupName'>
      <view class='court12'>切换小区</view>
    </picker>
  </view>
  <view class='body'>
    <block wx:for-items="{{members}}" wx:key="item.f_userid">
      <view class='view42'>
        <view class='view421'>
          <image class='img421' mode='scaleToFill' src='{{item.f_headpic}}'></image>
        </view>
        <view class='view422'>
          <view class='text422'>{{item.f_nickname}}</view>
          <view class='text4221'>{{item.f_Tel}}</view>
        </view>
        <view class='view423'>
          <text class='text4231' hidden='true'>{{item.f_leaveTime}}\n</text>
          <text class='text4232' hidden='{{!isMain}}' data-id='{{item.f_UnionID}}' data-it='{{item.f_nickname}}' bindtap='deleteit'>删除</text>
        </view>
      </view>
    </block>
  </view>
  <block wx:if='{{isMain&&members.length<4}}'>
    <view class='view3' hidden=''>
      <view class='view31'>添加成员
      </view>
      <view class='view32' bindtap='addmem'>
        <image class='img321' src='/images/me_icon_add.png'></image>
      </view>
    </view>
  </block>
</view>
<view class="tabBar">
  <view class="tabBar-item" bindtap='switchtab1'>
    <view class="viewalltab">
      <image class="icon" src='/images/home_notselected.png'></image>
    </view>
    <view class="tabBartext">首页</view>
  </view>
  <view class="tabBar-item" bindtap='switchtab2' hidden="{{!userid}}">
    <view class="viewalltab">
      <image class="icon" src='/images/qxm2.png'></image>
    </view>
    <view class="tabBartext">权限码</view>
  </view>
  <view class="tabBar-item">
    <view class="viewalltab">
      <image class="icon" src='/images/me_selected.png'></image>
    </view>
    <view class="tabBartext">我的</view>
  </view>
</view>