<view class='container'>
  <image class='img_bg' src='/images/fxys_bg2.png' mode='scaleToFill'></image>
  <view class='yellow'></view>
  <view class='head'  bindtap='bindtapToRefreshUsers'>
    <image class='img_court' src='/images/bzzx_xq.png'></image>
    <view class='court_name'>{{thisCourtName}}{{index}}</view>
    <picker bindchange='selectcourt'  value="{{index}}" range="{{courts}}" range-key='GroupName'>
      <view class='court12'  >切换小区</view>
    </picker>
  </view>
<view class="canvas-box" hidden='{{hideCanvas}}'>
    <canvas style="width:300px;height:300px;" canvas-id="mycanvas"/>
</view>
<view style='text-align:center;font-size:1rem;' hidden='{{hideCanvas}}'>请将权限码对准设备扫码识别区</view>
<button type='primary' class='shareqr' hidden='{{hideCanvas}}' bindtap='gotoshareqr'>访客二维码</button>
<view class='nopermit' hidden='{{!hideCanvas}}'>抱歉，您没有权限!</view>
</view>
  <view class="tabBar">
      <view class="tabBar-item" bindtap='switchtab1'>
        <view class="viewalltab"><image class="icon" src='/images/home_notselected.png'></image></view>
        <view class="tabBartext">首页</view>
    </view>
    <view class="tabBar-item">
        <view class="viewalltab"><image class="icon" src='/images/qxm3.png'></image></view>
        <view class="tabBartext">权限码</view>
    </view>
    <view class="tabBar-item" bindtap='switchtab3'>
        <view class="viewalltab"><image class="icon" src='/images/me.png'></image></view>
        <view class="tabBartext">我的</view>
    </view>
  </view>
