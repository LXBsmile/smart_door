<view class='container'>
  <view class="page-content">
    <!-- <courtpicker courtName='{{thisCourtName}}' courts='{{courts}}' index='{{index}}' showPicker='{{false}}' bindchange='selectcourt'></courtpicker> -->
    <view class='qr-section' hidden='{{hideCanvas}}'>
      <view class="canvas-box">
        <canvas style="width:200px;height:200px;" canvas-id="mycanvas" />
      </view>
      <view class='qr-tip'>请将权限码对准设备扫码识别区</view>
      <button type='primary' class='shareqr' hidden='{{!canVisitorManage}}' bindtap='gotoshareqr'>访客二维码</button>
    </view>
    <view class='nopermit' hidden='{{!hideCanvas}}'>抱歉，您没有权限!</view>
  </view>
</view>
<view class="tabBar">
  <view class="tabBar-item" bindtap='switchtab1'>
    <view class="viewalltab">
      <image class="icon" src='/images/home_notselected.png'></image>
    </view>
    <view class="tabBartext">首页</view>
  </view>
  <view class="tabBar-item">
    <view class="viewalltab">
      <image class="icon" src='/images/qxm3.png'></image>
    </view>
    <view class="tabBartext">权限码</view>
  </view>
  <view class="tabBar-item" bindtap='switchtab3'>
    <view class="viewalltab">
      <image class="icon" src='/images/me.png'></image>
    </view>
    <view class="tabBartext">我的</view>
  </view>
</view>
