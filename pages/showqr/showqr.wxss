/* pages/showqr/showqr.wxss */
.page-content {
  margin: 1rem;
  background-color: #fff;
  border-radius: 0.45rem;
  overflow: hidden;
  box-shadow:0 0.25rem 0.8rem rgba(0,0,0,0.06);
}

.img_bg{
  position: fixed;
  z-index: -1;
  width:100%;
  height: 100%;
}
.head{
  margin-right: 4%;
  margin-left:4%;
  height:3rem;
  background-color: white;
  display: flex;
  justify-content: center;
  align-items: center;
  border-bottom: solid 1px #ebebeb;
}
.img_court{
  height:2.1rem;
}

.court12{
  display: flex;
  flex-direction: column;
  justify-content: center;
  margin-right: 4%;
  width:5rem;
  height: 2rem;
  background-color: #ffbc16;
  color: white;
  border-top-left-radius:1rem; 
  border-bottom-left-radius: 1rem;
  text-align: center;
  font-size: 0.9rem;
}
.court12:active{
  background-color: #b2830f
}
.qr-section{
  padding:1.35rem 0 2rem;
}

.canvas-box{
  display: flex;
  justify-content: center;
  align-items: center;
  width:100%;
  min-height:260px;
  text-align:center;
}

.qr-tip{
  text-align:center;
  font-size:1rem;
  color:#4e5968;
  padding:0 1rem;
}

.nopermit{
  height: 20rem;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 1.5rem;
}
.shareqr{
  width:40%;
  text-align:center;
  margin:1.5rem auto 0;
}
