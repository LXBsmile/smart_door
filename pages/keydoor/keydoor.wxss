.container{min-height:100%;background:#f4f6f9;padding:0 0 1rem;box-sizing:border-box;}
.panel{margin:1.8rem 4% 0;background:#fff;box-sizing:border-box;box-shadow:0 8rpx 24rpx rgba(16,41,68,0.06);display:flex;flex-direction:column;}
.settingPanel{padding:1rem;background:#fff;box-sizing:border-box;}
.settingLabel{font-size:0.95rem;color:#333;line-height:2rem;text-align:center;}
.radioGroup{display:flex;justify-content:center;gap:0.7rem;flex-wrap:wrap;margin-top:0.35rem;}
.radioBtn{min-width:6.8rem;height:2.2rem;padding:0 0.8rem;border:1px solid #c9d5e3;border-radius:999rpx;display:flex;align-items:center;justify-content:center;box-sizing:border-box;background:#fff;}
.radioBtn.checked{border-color:#339adc;background:rgba(51,154,220,0.08);}
.radioIcon{width:0.9rem;height:0.9rem;border:1px solid #c9d5e3;border-radius:50%;margin-right:0.35rem;position:relative;box-sizing:border-box;flex-shrink:0;background:#fff;}
.radioIcon.checked{border-color:#339adc;}
.radioIcon.checked::after{content:'';position:absolute;left:50%;top:50%;width:0.42rem;height:0.42rem;border-radius:50%;background:#339adc;transform:translate(-50%,-50%);}
.radioText{font-size:0.92rem;color:#333;line-height:1;}
.bottomBtn{margin:0.8rem 1rem 1rem;background:#339adc;color:#fff;text-align:center;line-height:2.3rem;border-radius:0.3rem;}
