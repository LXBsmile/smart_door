/* pages/login/login.wxss */

.login-page{
  position:relative;
  min-height:100vh;
  height:auto;
  max-height:none;
  overflow-x:hidden;
  background:linear-gradient(180deg, #f4fbff 0%, #eef5fb 34%, #f7f9fc 100%);
}

.loginGlow{
  position:absolute;
  border-radius:50%;
  opacity:0.75;
}

.loginGlowTop{
  width:520rpx;
  height:520rpx;
  top:-220rpx;
  right:-160rpx;
  background:rgba(80, 178, 244, 0.18);
}

.loginGlowBottom{
  width:420rpx;
  height:420rpx;
  bottom:120rpx;
  left:-180rpx;
  background:rgba(254, 187, 23, 0.14);
}

.content{
  position:relative;
  z-index:1;
  width:100%;
  box-sizing:border-box;
  padding:84rpx 44rpx 72rpx;
}

.brandBlock{
  display:flex;
  flex-direction:column;
  align-items:center;
  margin-bottom:42rpx;
}

.brandLogoWrap{
  width:196rpx;
  height:196rpx;
  border-radius:54rpx;
  background:linear-gradient(180deg, #ffffff 0%, #f2f7fc 100%);
  box-shadow:0 18rpx 44rpx rgba(43,113,165,0.14);
  display:flex;
  align-items:center;
  justify-content:center;
}

.avatar{
  width:148rpx;
  height:148rpx;
  display:block;
}

.brandTitle{
  margin-top:26rpx;
  color:#213042;
  font-size:44rpx;
  font-weight:600;
  letter-spacing:2rpx;
}

.brandDesc{
  margin-top:10rpx;
  color:#6f7f90;
  font-size:26rpx;
  line-height:1.7;
  text-align:center;
  max-width:560rpx;
}

.loginCard{
  background:rgba(255,255,255,0.96);
  border:1rpx solid #e1ebf3;
  border-radius:32rpx;
  box-shadow:0 22rpx 56rpx rgba(45,90,128,0.12);
  padding:38rpx 28rpx 34rpx;
}

.cardEyebrow{
  color:#7eaed0;
  font-size:20rpx;
  letter-spacing:4rpx;
}

.cardTitle{
  margin-top:10rpx;
  color:#223144;
  font-size:38rpx;
  font-weight:600;
}

.cardDesc{
  margin-top:10rpx;
  color:#7a8796;
  font-size:24rpx;
  line-height:1.7;
  word-break:break-all;
}

.phonePreview{
  margin-top:24rpx;
  padding:22rpx 24rpx;
  border-radius:20rpx;
  background:#f4f9fd;
  border:1rpx solid #d9e9f5;
  box-sizing:border-box;
}

.phonePreviewLabel{
  color:#7a8796;
  font-size:22rpx;
  line-height:1.4;
}

.phonePreviewValue{
  margin-top:6rpx;
  color:#223144;
  font-size:34rpx;
  font-weight:700;
  line-height:1.35;
}

.phonePreviewDesc{
  margin-top:6rpx;
  color:#7ea0b8;
  font-size:22rpx;
  line-height:1.5;
}

.authBtn{
  margin-top:28rpx;
  width:100%;
  height:90rpx;
  line-height:90rpx;
  border-radius:22rpx;
  background:linear-gradient(180deg, #53b5f6 0%, #339adc 100%);
  box-shadow:0 16rpx 34rpx rgba(51,154,220,0.22);
  font-size:32rpx;
  font-weight:600;
}

.authBtn::after{
  border:none;
}

.otherPhoneBtn{
  margin-top:18rpx;
  width:100%;
  height:82rpx;
  line-height:82rpx;
  border-radius:20rpx;
  background:#f8fbfe;
  color:#339adc;
  border:1rpx solid #cfe1ef;
  font-size:30rpx;
  font-weight:600;
  box-shadow:none;
}

.otherPhoneBtn::after{
  border:none;
}

.protocolWrap{
  margin-top:26rpx;
  text-align:left;
}

.protocolRow{
  display:flex;
  align-items:center;
  min-height:48rpx;
}

.protocolCheckbox{
  transform:scale(0.84);
  transform-origin:left center;
  margin-right:6rpx;
  flex-shrink:0;
}

.protocolText{
  flex:1;
  min-width:0;
  display:flex;
  align-items:center;
  flex-wrap:wrap;
  font-size:22rpx;
  line-height:1.7;
  padding-top:2rpx;
}

.protocolPlain{
  color:#6f7a87;
  flex-shrink:0;
}

.protocolLink{
  display:inline-flex;
  color:#339adc;
  margin:0 2rpx;
  white-space:nowrap;
}

.protocolInlineGroup{
  display:inline-flex;
  align-items:center;
  white-space:nowrap;
}

.divider{
  position:relative;
  margin:30rpx 0 24rpx;
  text-align:center;
}

.divider::before{
  content:'';
  position:absolute;
  left:0;
  right:0;
  top:50%;
  height:1rpx;
  background:#e6edf3;
}

.dividerText{
  position:relative;
  display:inline-block;
  padding:0 20rpx;
  background:#fff;
  color:#95a2af;
  font-size:22rpx;
}

.accountEntry{
  display:block;
}

.accountBtn{
  width:100%;
  height:82rpx;
  border-radius:20rpx;
  border:1rpx solid #cfe1ef;
  background:#f8fbfe;
  color:#339adc;
  font-size:30rpx;
  font-weight:600;
  display:flex;
  align-items:center;
  justify-content:center;
  box-sizing:border-box;
}

.tipCard{
  margin-top:28rpx;
  padding:26rpx 30rpx;
  border-radius:28rpx;
  background:rgba(255,255,255,0.88);
  border:1rpx solid #edf1f5;
  box-shadow:0 14rpx 34rpx rgba(55,90,120,0.08);
}

.tipTitle{
  color:#de6b6b;
  font-size:28rpx;
  font-weight:600;
}

.tipItem{
  margin-top:12rpx;
  color:#8a6770;
  font-size:24rpx;
  line-height:1.8;
}

.protocolConfirmMask{
  position:fixed;
  left:0;
  right:0;
  top:0;
  bottom:0;
  z-index:99;
  background:rgba(26,43,58,0.48);
  display:flex;
  align-items:center;
  justify-content:center;
  padding:48rpx;
  box-sizing:border-box;
}

.protocolConfirmDialog{
  width:100%;
  max-width:640rpx;
  border-radius:24rpx;
  background:#fff;
  padding:38rpx 34rpx 30rpx;
  box-sizing:border-box;
  box-shadow:0 22rpx 64rpx rgba(18,47,74,0.22);
}

.protocolConfirmTitle{
  color:#223144;
  font-size:34rpx;
  font-weight:600;
  text-align:center;
}

.protocolConfirmContent{
  margin-top:24rpx;
  color:#6f7a87;
  font-size:27rpx;
  line-height:1.8;
}

.protocolConfirmLink{
  display:inline;
  color:#339adc;
}

.protocolConfirmActions{
  margin-top:34rpx;
  display:flex;
  gap:20rpx;
}

.protocolConfirmBtn{
  flex:1;
  height:80rpx;
  line-height:80rpx;
  border-radius:18rpx;
  font-size:30rpx;
  font-weight:600;
  margin:0;
  padding:0;
}

.protocolConfirmBtn::after{
  border:none;
}

.protocolConfirmCancel{
  color:#7b8794;
  background:#f3f7fb;
}

.protocolConfirmOk{
  color:#fff;
  background:#339adc;
}
