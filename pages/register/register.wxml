<!--pages/register/register.wxml-->
<view class='container'>
  <view class='view1'>
    <view class='view11'>
     <input class='input1' maxlength='11' type='number' auto-focus placeholder='请输入手机号码' bindinput='setTel' value='{{tel}}'></input>
    </view>
  </view>
  <view class='view2' hidden='{{!isCode}}'>
    <view class='view21'>
      <input class='input2' maxlength='6' type='number'  bindinput='setCode' placeholder='验证码' value='{{code}}'></input>
    </view>
    <view class='view22'>
      <button type='primary' class='button2' open-type="getUserInfo" bindgetuserinfo="getCode"  disabled='{{disabled2}}' loading='{{loading}}'>{{loadingtext}}</button>
      </view>
  </view>
  <view class='view3'>
  <checkbox-group bindchange='checkboxChange'>
    <checkbox value="1">
      <label>我已阅读并接受</label>
    </checkbox>
  </checkbox-group>
    <navigator class='navigator3' url='/pages/protocol/protocol'>《用户使用条款》</navigator>
  </view>
  <view class='view4'>
    <button type='primary' class='button4' open-type="getUserInfo" disabled='{{disabled3}}' bindgetuserinfo="registerUser">{{typeName}}</button>
  </view>
</view>
