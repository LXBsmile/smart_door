.va-page{
  background:#fff;
}
.img_bg{
  position:fixed;
  z-index:-1;
  width:100%;
  height:100%;
}
.panel{
  margin:0.85rem 6% 0;
  background:#fff;
  overflow:hidden;
}
.form-panel{
  padding:0.45rem 0 1rem;
}
.field{
  margin:0.9rem 4%;
  border-bottom:1px solid #77b8e8;
  min-height:1.9rem;
  display:flex;
  align-items:center;
  font-size:1rem;
}
.field-time{
  justify-content:flex-start;
}
.field-select{
  min-height:2.3rem;
}
.field-icon{
  width:1rem;
  height:1rem;
}
.field-input{
  flex:1;
  padding-left:0.5rem;
  font-size:1rem;
  color:#333;
  min-width:0;
}
.field-select-text{
  line-height:1.5rem;
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
}
.placeholder{
  color:#999;
}
.field-arrow{
  width:0.45rem;
  height:0.45rem;
  border-top:1px solid #9cb7cd;
  border-right:1px solid #9cb7cd;
  transform:rotate(45deg);
  margin-left:0.35rem;
  flex-shrink:0;
}
.picker-text{
  padding-left:0.5rem;
  padding-right:0.45rem;
  color:#666;
  font-size:1rem;
  white-space:nowrap;
}
.date-text{
  min-width:7.2rem;
}
.suffix{
  color:#999;
  font-size:1rem;
}
.device-box{
  margin:0 4% 0.35rem;
  color:#999;
  font-size:0.74rem;
  line-height:1.6;
}
.submit-btn{
  margin:0.9rem 8% 0;
  background:#b5b5b5;
  color:#fff;
  border-radius:0;
  font-size:1rem;
  line-height:2.45rem;
}
