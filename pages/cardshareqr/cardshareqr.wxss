.container {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.canvas-box {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 100%;
  border-bottom: thin solid #b2b2b2;
  margin-bottom: 10px;
}

page {
  background: #fff;
}

.settings-panel {
  width: 100%;
  flex-grow: 1;
}

.create-header-title {
  font-weight: 700;
  display: inline-block;
  width: 100%;
  text-align: center;
  margin-bottom: 10px;
}

.create-time-options {
  display: flex;
  flex-direction: row;
  align-items: center;
  width: 100%;
}

.options-title {
  min-width: 140rpx;
  text-align: right;
  padding-right: 20rpx;
}

.slider-box {
  flex-grow: 1;
}

.valid-date {
  text-align: center;
}

.btn-save {
  position: absolute;
  bottom: 10%;
  left: 10%;
  right: 10%;
  background: #4876ff;
  color: #fff;
}

