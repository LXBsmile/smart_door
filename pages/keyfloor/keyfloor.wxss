.container{min-height:100%;background:#f4f6f9;padding:0 0 1rem;box-sizing:border-box;}
.panel{margin:1.8rem 4% 0;background:#fff;box-sizing:border-box;box-shadow:0 8rpx 24rpx rgba(16,41,68,0.06);display:flex;flex-direction:column;}
.selectPanel{margin:1.35rem 4% 0;background:#fff;box-sizing:border-box;box-shadow:0 8rpx 24rpx rgba(16,41,68,0.06);padding:0.95rem 0.85rem 1.05rem;}
.floorCircleGrid{display:grid;grid-template-columns:repeat(4, 1fr);gap:0.76rem 0.62rem;align-items:center;justify-items:center;}
.floorCircle{width:3rem;height:3rem;border:3rpx solid #339adc;border-radius:50%;box-sizing:border-box;background:#eaf6ff;color:#339adc;font-size:0.82rem;font-weight:600;display:flex;align-items:center;justify-content:center;box-shadow:inset 0 0 0 5rpx rgba(51,154,220,0.16);}
.floorCircle:active{background:#339adc;color:#fff;}
.floorCircleDisabled{opacity:0.55;}
.floorCircleDisabled:active{background:#eaf6ff;color:#339adc;}
.emptyTip{text-align:center;color:#999;font-size:0.85rem;padding:4rem 0;}
.allRow{padding:0.8rem 1rem;background:#fff;color:#339adc;border-top:1px solid #edf1f6;border-bottom:1px solid #edf1f6;box-sizing:border-box;}
.grid{display:flex;flex-wrap:wrap;padding:0.8rem 1rem;background:#fff;box-sizing:border-box;}
.cell{width:25%;padding:0.35rem 0;font-size:0.8rem;box-sizing:border-box;}
.cellInner{display:flex;align-items:center;}
.cellCheckbox{width:1rem;height:1rem;border:1px solid #c9d5e3;border-radius:0.15rem;background:#fff;display:flex;align-items:center;justify-content:center;box-sizing:border-box;flex-shrink:0;margin-right:0.28rem;}
.cellCheckbox.checked{background:#339adc;border-color:#339adc;}
.cellCheckboxMark{width:0.5rem;height:0.28rem;border-left:0.12rem solid transparent;border-bottom:0.12rem solid transparent;transform:rotate(-45deg);box-sizing:border-box;}
.cellCheckbox.checked .cellCheckboxMark{border-left-color:#fff;border-bottom-color:#fff;}
.cellLabel{font-size:0.75rem;color:#333;line-height:1.2;}
.settingPanel{padding:0.2rem 1rem 0.9rem;background:#fff;box-sizing:border-box;}
.settingLabel{font-size:0.95rem;color:#333;line-height:2rem;text-align:center;}
.radioGroup{display:flex;justify-content:center;gap:0.7rem;flex-wrap:wrap;margin-top:0.35rem;}
.radioBtn{min-width:6.8rem;height:2.2rem;padding:0 0.8rem;border:1px solid #c9d5e3;border-radius:999rpx;display:flex;align-items:center;justify-content:center;box-sizing:border-box;background:#fff;}
.radioBtn.checked{border-color:#339adc;background:rgba(51,154,220,0.08);}
.radioIcon{width:0.9rem;height:0.9rem;border:1px solid #c9d5e3;border-radius:50%;margin-right:0.35rem;position:relative;box-sizing:border-box;flex-shrink:0;background:#fff;}
.radioIcon.checked{border-color:#339adc;}
.radioIcon.checked::after{content:'';position:absolute;left:50%;top:50%;width:0.42rem;height:0.42rem;border-radius:50%;background:#339adc;transform:translate(-50%,-50%);}
.radioText{font-size:0.92rem;color:#333;line-height:1;}
.bottomBtn{margin:0.8rem 1rem 1rem;background:#339adc;color:#fff;text-align:center;line-height:2.3rem;border-radius:0.3rem;}
