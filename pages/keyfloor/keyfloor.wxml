<view class='container'>
  <view class='panel' wx:if='{{mode=="setting"}}'>
    <view class='allRow' bindtap='toggleAll'>{{allChecked?'取消全选':'全选楼层'}}</view>
    <view class='grid'>
      <block wx:for='{{floors}}' wx:key='item.key'>
        <view class='cell' bindtap='toggleOne' data-key='{{item.key}}'>
          <view class='cellInner'>
            <view class='cellCheckbox {{checkedMap[item.key]?"checked":""}}'>
              <view class='cellCheckboxMark'></view>
            </view>
            <text class='cellLabel'>{{item.label}}</text>
          </view>
        </view>
      </block>
    </view>
    <view class='settingPanel' wx:if='{{mode=="setting"}}'>
      <view class='settingLabel'>{{devName}}</view>
      <view class='radioGroup'>
        <view class='radioBtn {{!openMode?"checked":""}}' bindtap='setOpenMode' data-value='false'>
          <view class='radioIcon {{!openMode?"checked":""}}'></view>
          <text class='radioText'>开启控制</text>
        </view>
        <view class='radioBtn {{openMode?"checked":""}}' bindtap='setOpenMode' data-value='true'>
          <view class='radioIcon {{openMode?"checked":""}}'></view>
          <text class='radioText'>常开模式</text>
        </view>
      </view>
    </view>
    <view class='bottomBtn' bindtap='submit'>{{actionText}}</view>
  </view>
  <view class='selectPanel' wx:else>
    <view class='floorCircleGrid'>
      <block wx:for='{{floors}}' wx:key='item.key'>
        <view class='floorCircle {{openingDoor?"floorCircleDisabled":""}}' bindtap='executeFloor' data-key='{{item.key}}'>{{item.label}}</view>
      </block>
    </view>
    <view class='emptyTip' wx:if='{{!floors.length}}'>暂无可选楼层</view>
  </view>
</view>
