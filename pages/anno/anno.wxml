<view class='container'>
  <view class='head'>
    <view class='court11'>{{thisCourtName}}</view>
    <picker bindchange='selectcourt' value="{{index}}" range="{{courts}}" range-key='GroupName'>
      <view class='court12'>切换小区</view>
    </picker>
  </view>
  <view class='body'>
  <block wx:for="{{annos}}" wx:for-index="idx" wx:key="f_noticeID">
    <navigator class='list' data-id='{{item.f_noticeID}}' bindtap='setVisited' url='/pages/annocontent/annocontent?f_noticeID={{item.f_noticeID}}&f_noticeName={{item.f_noticeName}}&f_noticeMsg={{item.f_noticeMsg}}'>
        <view class='item'>
          <view class='title{{disablelist[item.f_noticeID]}}'>{{item.f_noticeName}}</view>
          <block wx:if='{{(!disablelist[item.f_noticeID])}}'>
            <image class='image_new' src='/images/ggzx_new.png' mode='widthFix'></image>
          </block>
        <view class='time'>{{item.f_date}}</view>
      </view>
      <image class='img_right' src='/images/right.png' mode='widthFix'>
      </image>
    </navigator>
  </block>
  </view>
</view>