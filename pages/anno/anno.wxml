<view class='container'>
  <!-- <courtpicker courtName='{{thisCourtName}}' courts='{{courts}}' index='{{index}}' showPicker='{{false}}' bindchange='selectcourt'></courtpicker> -->
  <view class='body'>
  <block wx:if='{{annos.length}}'>
    <block wx:for="{{annos}}" wx:for-index="idx" wx:key="f_noticeID">
    <view class='list' data-id='{{item.f_noticeID}}' data-index='{{index}}' bindtap='gotoDetail'>
        <view class='item'>
          <view class='title-row'>
            <view class='title{{disablelist[item.f_noticeID]?"true":"false"}}'>{{item.f_noticeName}}</view>
            <block wx:if='{{(!disablelist[item.f_noticeID])}}'>
              <image class='image_new' src='/images/ggzx_new.png' mode='widthFix'></image>
            </block>
          </view>
        <view class='time'>{{item.f_date}}</view>
      </view>
      <image class='img_right' src='/images/right.png' mode='widthFix'>
      </image>
    </view>
    </block>
  </block>
  <view class='empty-tip' wx:else>{{emptyText}}</view>
  </view>
</view>
