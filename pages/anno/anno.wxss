/* pages/anno/anno.wxss */
.container{
  background:#f5f7fb;
  min-height:100%;
}

.body{
  margin:0.8rem 4% 1rem;
  background:#fff;
  border-radius:0.45rem;
  box-shadow:0 0.25rem 0.8rem rgba(0,0,0,0.06);
  overflow:hidden;
  min-height:12rem;
}

.list{
  display:flex;
  justify-content:space-between;
  align-items:center;
  min-height:3.9rem;
  padding:0.85rem 0.8rem 0.8rem;
  border-bottom:1px solid #ebebeb;
  box-sizing:border-box;
}

.item{
  flex:1;
  min-width:0;
}

.title-row{
  display:flex;
  align-items:center;
  min-width:0;
}

.title,
.titlefalse,
.titletrue{
  flex:1;
  min-width:0;
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
  line-height:1.35rem;
}

.title,
.titlefalse{
  color:#333;
}

.titletrue{
  color:#757575;
}

.time{
  margin-top:0.22rem;
  color:#8e99a6;
  font-size:0.78rem;
}

.image_new{
  width:2rem;
  margin-left:0.45rem;
  flex-shrink:0;
}

.img_right{
  width:0.8rem;
  margin-left:0.7rem;
  flex-shrink:0;
}

.empty-tip{
  min-height:12rem;
  display:flex;
  align-items:center;
  justify-content:center;
  color:#98a0aa;
  font-size:0.92rem;
  padding:1rem;
  box-sizing:border-box;
}
