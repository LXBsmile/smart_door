<view class='container'>
  <image class='img_bg' src='/images/fxys_bg2.png' mode='scaleToFill'></image>
  <view class="key_list">
    <!-- <courtpicker courtName='{{thisCourtName}}' courts='{{courts}}' index='{{index}}' showPicker='{{false}}' bindchange='selectcourt'></courtpicker> -->
    <view class='tools'>
      <view class='filter'>
        <view class='tag {{filterType=="all"?"tag_on":""}}' data-type='all' bindtap='setFilter'>全部</view>
        <view class='tag {{filterType=="door"?"tag_on":""}}' data-type='door' bindtap='setFilter'>门禁</view>
        <view class='tag {{filterType=="lift"?"tag_on":""}}' data-type='lift' bindtap='setFilter'>梯控</view>
      </view>
      <view class='searchRow'>
        <input class='searchInput' placeholder='搜索名称' bindinput='inputKeyword' bindconfirm='search' confirm-type='search' value='{{keyword}}'></input>
        <view class='searchBtn' bindtap='search'>搜索</view>
      </view>
    </view>
    <view class='view_keylist'>
      <block wx:for="{{keys}}" wx:key='itemKey'>
        <view class='view_content'>
          <view class='leftBox'>
            <view class='view_name'>{{item.f_devName}}</view>
            <view class='view_type'>{{item.typeName}}{{item.type=="lift"&&item.floorInfo.floors.length?" · 长按开锁图标可单选楼层":""}}</view>
          </view>
          <view class='rightBox'>
            <view class='setBtn' wx:if='{{isManager&&item.type}}' bindtap='gotoSetting' data-index='{{index}}'>
              <view class='setIcon'>
                <view class='setLine setLine1'>
                  <view class='setDot'></view>
                </view>
                <view class='setLine setLine2'>
                  <view class='setDot'></view>
                </view>
                <view class='setLine setLine3'>
                  <view class='setDot'></view>
                </view>
              </view>
            </view>
            <image
              class='img_lock {{openingDoor?"img_lock_disabled":""}}'
              data-index='{{index}}'
              bindtap='unlock'
              bindlongpress='handleUnlockLongPress'
              src='/images/lock.png'
              mode='aspectFit'></image>
          </view>
        </view>
      </block>
    </view>
  </view>
</view>
