<view class='container'>
  <image class='img_bg' src='/images/fxys_bg2.png' mode='scaleToFill'></image>
  <view class='yellow'></view>
  <view class='head'>
    <image class='img_court' src='/images/bzzx_xq.png'></image>
    <view class='court_name'>{{thisCourtName}}</view>
    <picker bindchange='selectcourt' value="{{index}}" range="{{courts}}" range-key='GroupName'>
      <view class='court12'>切换小区</view>
    </picker>
  </view>
  <view class='view_keylist'>
  <block wx:for="{{keys}}" wx:key='item.id'>
    <view class='view_content'>
      <view>
        <view class='view_id'>{{item.f_devNum}}</view>
        <view class='view_name'>{{item.f_devName}}</view>
      </view>
      <image class='img_lock' id='{{item.f_devNum}}' bindtap='unlock' src='/images/lock.png'></image>
    </view>
  </block>
  </view>
</view>