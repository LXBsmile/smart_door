/* pages/keyslist/keyslist.wxss */
.img_bg{
  position: fixed;
  z-index: -1;
  width:100%;
  height: 100%;
}
.key_list {
  margin: 1rem;
  overflow: hidden;
  border-radius: 1rem;
  height: calc(100vh - 2rem);
  display: flex;
  flex-direction: column;
  background: #fff;
}
.tools{
  background:#fff;
  padding:0.76rem 0.8rem 0.78rem;
  border-bottom:1px solid #edf2f7;
  flex-shrink:0;
}
.filter{
  display:flex;
  align-items:center;
  justify-content:space-between;
  margin-bottom:0.66rem;
  padding:0.14rem;
  background:#f3f6fa;
  border-radius:0.44rem;
}
.tag{
  width:32%;
  min-width:0;
  text-align:center;
  border:none;
  border-radius:0.34rem;
  padding:0;
  line-height:1.95rem;
  background:transparent;
  color:#6d7886;
  font-size:0.82rem;
  font-weight:500;
  box-sizing:border-box;
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
}
.tag_on{
  background:linear-gradient(180deg, #50b2f4 0%, #339adc 100%);
  color:#fff;
  box-shadow:0 0.18rem 0.38rem rgba(51,154,220,0.24);
}
.searchRow{
  display:flex;
  align-items:center;
  padding:0.14rem;
  background:#f8fafc;
  border:1px solid #dbe5ef;
  border-radius:0.44rem;
  box-sizing:border-box;
}
.searchInput{
  flex:1;
  min-width:0;
  height:1.9rem;
  border:none;
  background:transparent;
  padding:0 0.62rem;
  color:#384454;
  font-size:0.82rem;
}
.searchBtn{
  margin-left:0.2rem;
  min-width:3.55rem;
  background:linear-gradient(180deg, #50b2f4 0%, #339adc 100%);
  color:#fff;
  padding:0 0.82rem;
  height:1.86rem;
  border-radius:0.34rem;
  box-shadow:0 0.16rem 0.36rem rgba(51,154,220,0.22);
  font-size:0.8rem;
  font-weight:500;
  display:flex;
  align-items:center;
  justify-content:center;
  box-sizing:border-box;
  flex-shrink:0;
  white-space:nowrap;
}
.view_keylist{
  overflow-y:auto;
  flex:1;
  min-height:0;
  background:#fff;
}
.view_content{
  display:flex;
  min-height:3.4rem;
  justify-content:space-between;
  align-items:center;
  padding:0.9rem 1rem;
  border-bottom:1px solid #e9e9e9;
}
.leftBox{
  flex:1;
  min-width:0;
}
.view_name{
  color:#333;
  font-size:1rem;
  line-height:1.3;
}
.view_type{
  color:#999;
  font-size:0.75rem;
  margin-top:0.18rem;
  line-height:1.3;
}
.rightBox{
  display:flex;
  align-items:center;
  gap:1.38rem;
  flex-shrink:0;
}
.setBtn{
  width:2.6rem;
  height:2.6rem;
  display:flex;
  align-items:center;
  justify-content:center;
  background:transparent;
  border:none;
  padding:0;
  flex-shrink:0;
}
.setIcon{
  position:relative;
  width:2.1rem;
  height:2.1rem;
}
.setLine{
  position:absolute;
  left:0.24rem;
  right:0.24rem;
  height:0.2rem;
  background:#339adc;
  border-radius:999px;
}
.setLine1{
  top:0.32rem;
}
.setLine2{
  top:0.95rem;
}
.setLine3{
  top:1.58rem;
}
.setDot{
  position:absolute;
  top:50%;
  width:0.44rem;
  height:0.44rem;
  border-radius:50%;
  background:#339adc;
  transform:translateY(-50%);
}
.setLine1 .setDot{
  left:0.12rem;
}
.setLine2 .setDot{
  right:0.16rem;
}
.setLine3 .setDot{
  left:0.76rem;
}
.img_lock{
  width:2.6rem;
  height:2.6rem;
  display:block;
  flex-shrink:0;
}
.img_lock_disabled{
  opacity:0.55;
}
