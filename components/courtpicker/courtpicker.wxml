<picker wx:if='{{showPicker}}' bindchange='onPickerChange' value="{{index}}" range="{{courts}}" range-key='GroupName'>
  <view class='head'>
    <view class='court_name'>
      <text class='court_main'>{{courtName}}</text>
    </view>
  </view>
</picker>
<view wx:else class='head'>
  <view class='court_name'>
    <text class='court_main'>{{courtName}}</text>
  </view>
</view>
